{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": [
      "node",
      "bun"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "test/unit/**/*.ts",
    "test/pack/**/*.mjs"
  ]
}
