    "sources": [
      {
        "id": "databricks.queries",
        "kind": "events",
        "reads": "x-databricks/query",
        "method": "events_list",
        "input": {
          "source": "queries"
        },
        "service": {
          "id": "databricks.sql",
          "label": "SQL"
        },
        "operations": [
