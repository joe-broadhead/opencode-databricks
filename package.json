{
  "name": "@joe-broadhead/opencode-databricks",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial OpenCode plugin for Databricks",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "databricks",
    "unity-catalog",
    "sql"
  ],
  "homepage": "https://github.com/joe-broadhead/opencode-databricks#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-databricks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-databricks.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./tui": {
      "default": "./dist/tui.js"
    },
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "conformance": "node scripts/check.mjs conformance",
    "test:kit": "node scripts/check.mjs kit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check-forbidden.mjs --self-test && node scripts/check.mjs forbidden copies",
    "icons": "node scripts/check.mjs icons"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/source-contract": "github:we-the-rebel-alliance/source-contract#v0.2.0",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "opencode": {
    "host": ">=2.2.3 <2.4.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "databricks",
      "name": "Databricks",
      "domain": "databricks.com"
    }
  },
  "jelly": {
    "title": "Databricks",
    "summary": "Find, query and save your Databricks data, with every change planned first.",
    "icon": "assets/icon.svg",
    "cost": "Queries run on a SQL warehouse your workspace bills by the hour while it runs (serverless list price about $0.70 per DBU, a 2X-Small uses 4 DBU an hour); starting a stopped one bills until it auto-stops. AI functions and jobs bill separately.",
    "admin": "add an OAuth app connection (public client) with this plugin's redirect URLs in the account console, and give you Can use on a SQL warehouse and SELECT on the data you read",
    "tools": [],
    "skills": [
      "opencode-databricks",
      "opencode-databricks-sql"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "databricks",
        "label": "Databricks workspace",
        "integration": "databricks-*",
        "scopes": [
          "all-apis",
          "email",
          "files",
          "jobs",
          "offline_access",
          "openid",
          "profile",
          "query-history",
          "sql",
          "unity-catalog",
          "workspace"
        ],
        "relay": {
          "redirectField": "redirectUri",
          "portField": "callbackPort"
        },
        "help": {
          "url": "https://docs.databricks.com/aws/en/integrations/enable-disable-oauth",
          "label": "Add an OAuth app connection"
        },
        "account": {
          "option": "accounts",
          "label": "Workspace name",
          "placeholder": "work",
          "value": {
            "mode": "interactive"
          },
          "description": "A short name for one Databricks workspace, such as work. You enter the workspace URL and your admin's OAuth client ID when you sign in. At Allowed, the agent can change or delete anything your Databricks identity can, after a plan it makes itself. For a hard limit, sign in with a read-only role. Column masks and row filters set by your admins run their own functions on every read; Databricks enforces them, and the plugin cannot see them."
        },
        "needed": [
          "AUTH_REQUIRED",
          "AUTH_SCOPE_MISSING"
        ]
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "description": "How much the plugin's tools may do. Generates default rules for agents with a base allow rule; plan-then-commit still applies.",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run, and may start a small serverless warehouse that bills until it auto-stops. Changes never run."
            }
          ],
          "default": "all"
        }
      ]
    }
  }
}
