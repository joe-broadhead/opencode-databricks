{
  "name": "@joe-broadhead/opencode-databricks",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial OpenCode plugin for Databricks",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "databricks",
    "unity-catalog",
    "sql"
  ],
  "homepage": "https://github.com/joe-broadhead/opencode-databricks#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-databricks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-databricks.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./tui": {
      "default": "./dist/tui.js"
    },
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "conformance": "node scripts/check.mjs conformance",
    "test:kit": "node scripts/check.mjs kit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check-forbidden.mjs --self-test && node scripts/check.mjs forbidden copies",
    "icons": "node scripts/check.mjs icons",
    "parser": "node scripts/check.mjs parser",
    "fuzz": "node test/fuzz/run.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/source-contract": "github:we-the-rebel-alliance/source-contract#v0.3.0",
    "antlr-ng": "1.0.10",
    "antlr4ng": "3.0.16",
    "apache-arrow": "21.1.0",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "hyparquet": "1.32.0",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "opencode": {
    "host": ">=2.2.3 <2.4.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "databricks",
      "name": "Databricks",
      "domain": "databricks.com"
    }
  },
  "jelly": {
    "title": "Databricks",
    "summary": "Find, query and save your Databricks data, with every change planned first.",
    "icon": "assets/icon.svg",
    "cost": "A SQL warehouse bills by the hour while it runs (serverless about $0.70 per DBU, 4 DBU an hour at 2X-Small); starting a stopped one bills until it auto-stops. Saved-query reads run only on a warehouse already running, which then stays up until it auto-stops. AI functions and jobs bill separately.",
    "admin": "add an OAuth app connection (public client) with this plugin's redirect URLs, including Jelly's relay, in the account console, and give you Can use on a SQL warehouse and SELECT on the data you read",
    "tools": [
      {
        "name": "databricks.status",
        "permission": "databricks.status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.catalog",
        "permission": "databricks.catalog",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.table",
        "permission": "databricks.table",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.warehouses",
        "permission": "databricks.warehouses",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.explain",
        "permission": "databricks.explain",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.query",
        "permission": "databricks.query",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.statement",
        "permission": "databricks.statement",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.history",
        "permission": "databricks.history",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.profile",
        "permission": "databricks.profile",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.jobs",
        "permission": "databricks.jobs",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.workspace",
        "permission": "databricks.workspace",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.plan",
        "permission": "databricks.plan",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.events_list",
        "permission": "databricks.events_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.saved_read",
        "permission": "databricks.saved_read",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.save",
        "permission": "databricks.save",
        "effect": "allow",
        "readOnly": false,
        "note": "Writes query results to a file on this machine"
      },
      {
        "name": "databricks.write",
        "permission": "databricks.write",
        "effect": "allow",
        "readOnly": false,
        "note": "At Allowed, the agent can change or delete anything your Databricks identity can, after a plan it makes itself. For a hard limit, sign in with a read-only role."
      },
      {
        "name": "databricks.delete",
        "permission": "databricks.delete",
        "effect": "allow",
        "readOnly": false,
        "note": "Deletes, drops, overwrites and vacuums. Runs without asking at Allowed; asks every time at Ask before changes"
      },
      {
        "name": "databricks.share",
        "permission": "databricks.share",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "databricks.export",
        "permission": "databricks.export",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "databricks.run",
        "permission": "databricks.run",
        "effect": "allow",
        "readOnly": false,
        "note": "Runs jobs, notebooks and SQL scripts. Runs without asking at Allowed; asks every time at Ask before changes"
      },
      {
        "name": "databricks.admin",
        "permission": "databricks.admin",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "databricks.cancel",
        "permission": "databricks.cancel",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "databricks.stop",
        "permission": "databricks.stop",
        "effect": "allow",
        "readOnly": false,
        "note": "Stops a SQL warehouse the agent finds idle; never ends other people's queries"
      },
      {
        "name": "databricks.start",
        "permission": "databricks.start",
        "effect": "ask",
        "readOnly": true,
        "note": "Starts a stopped SQL warehouse, which bills until it auto-stops"
      },
      {
        "name": "databricks.probe",
        "permission": "databricks.probe",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "databricks.read",
        "permission": "databricks.read",
        "effect": "allow",
        "readOnly": true,
        "note": "Reads the Databricks data a source you bound names; never changes anything"
      }
    ],
    "skills": [
      "opencode-databricks",
      "opencode-databricks-sql"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "databricks",
        "label": "Databricks workspace",
        "integration": "databricks-*",
        "scopes": [
          "all-apis",
          "email",
          "files",
          "jobs",
          "offline_access",
          "openid",
          "profile",
          "query-history",
          "sql",
          "unity-catalog",
          "workspace"
        ],
        "relay": {
          "redirectField": "redirectUri",
          "portField": "callbackPort"
        },
        "help": {
          "url": "https://docs.databricks.com/aws/en/integrations/enable-disable-oauth",
          "label": "Add an OAuth app connection"
        },
        "account": {
          "option": "accounts",
          "label": "Workspace name",
          "placeholder": "work",
          "value": {
            "mode": "interactive"
          },
          "description": "A short name for one Databricks workspace, such as work. You enter the workspace URL and your admin's OAuth client ID when you sign in. At Allowed, the agent can change or delete anything your Databricks identity can, after a plan it makes itself. For a hard limit, sign in with a read-only role. Column masks and row filters set by your admins run their own functions on every read; Databricks enforces them, and the plugin cannot see them."
        },
        "needed": [
          "AUTH_REQUIRED",
          "AUTH_SCOPE_MISSING"
        ]
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "description": "How much the plugin's tools may do. Generates default rules for agents with a base allow rule; plan-then-commit still applies.",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run, and may start a small serverless warehouse that bills until it auto-stops. Changes never run."
            }
          ],
          "default": "all"
        }
      ]
    }
  },
  "sources": {
    "contractVersion": 1,
    "rpc": "databricks.databricks.tools",
    "probe": {
      "action": "databricks.probe"
    },
    "items": [
      {
        "id": "databricks.queries",
        "kind": "events",
        "reads": "x-databricks/query",
        "tool": "events_list",
        "input": {
          "source": "queries"
        },
        "accounts": {
          "named": true
        },
        "scope": {
          "keys": [
            "warehouses"
          ],
          "describe": "Which SQL warehouses' statements to read: only statements you ran"
        },
        "permission": {
          "events": "databricks.events_list",
          "operations": [
            "sql.history.queries.list",
            "scim.me.get"
          ],
          "identity": [
            "scim.me.get"
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 262144,
        "retentionDays": 30,
        "urlHosts": [
          "*.cloud.databricks.com",
          "*.azuredatabricks.net",
          "*.gcp.databricks.com"
        ]
      },
      {
        "id": "databricks.runs",
        "kind": "events",
        "reads": "x-databricks/run",
        "tool": "events_list",
        "input": {
          "source": "runs"
        },
        "accounts": {
          "named": true
        },
        "scope": {
          "keys": [
            "jobs"
          ],
          "describe": "Which jobs' finished runs to read; empty means every job you can see"
        },
        "permission": {
          "events": "databricks.events_list",
          "operations": [
            "jobs.runs.list",
            "jobs.runs.get",
            "scim.me.get"
          ],
          "identity": [
            "scim.me.get"
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 262144,
        "retentionDays": 60,
        "urlHosts": [
          "*.cloud.databricks.com",
          "*.azuredatabricks.net",
          "*.gcp.databricks.com"
        ]
      },
      {
        "id": "databricks.saved",
        "kind": "snapshot",
        "tool": "saved_read",
        "output": "table",
        "params": {
          "query": {},
          "sha": {}
        },
        "accounts": {
          "named": true
        },
        "scope": {
          "keys": [
            "queries"
          ],
          "describe": "Which of your saved SQL queries to read, shown with their SQL. Each read runs only on a warehouse that is already running, which then stays up until it auto-stops.",
          "suggest": {
            "tool": "saved_list",
            "operations": [
              "sql.queries.list"
            ]
          }
        },
        "permission": {
          "tool": "databricks.saved_read",
          "operations": [
            "sql.queries.get",
            "sql.warehouses.get",
            "sql.statements.query",
            "sql.statements.get",
            "scim.me.get"
          ],
          "identity": [
            "scim.me.get"
          ]
        },
        "private": true,
        "maxAgeSec": 3600,
        "maxBytes": 262144,
        "cost": {
          "class": "billed",
          "units": [
            {
              "per": "dbu",
              "usd": 0.7
            }
          ],
          "probe": {
            "per": "call",
            "usd": 0
          }
        }
      }
    ]
  }
}
